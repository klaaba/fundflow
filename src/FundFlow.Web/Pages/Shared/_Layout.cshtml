<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – FundFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">FundFlow</a>
    </header>

    <main class="content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        Unabhängiger Demonstrator · Fiktive Daten · Keine Anlageberatung
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
